# Google API Key (required for Gemini)
GOOGLE_API_KEY=your_google_api_key

# YouTube Data API Key (required for YouTube search)
YOUTUBE_API_KEY=your_youtube_data_api_key

# Memories.ai Video Datalake API Key (for video_index / video_analysis / video_moment_search)
# Create one in the Console (https://console.memories.ai) -> API keys
MEMORIES_API_KEY=sk-mai-your_datalake_api_key

# Video Datalake optional configuration
MEMORIES_BASE_URL=https://api.memories.ai/serve/datalake/v1
# Index into an existing collection; leave empty to create/reuse one by name
MEMORIES_COLLECTION_ID=
MEMORIES_COLLECTION_NAME=video-searching-agent
MEMORIES_INDEX_FPS=1.0
MEMORIES_INDEX_WAIT_SECONDS=120
MEMORIES_INDEX_POLL_SECONDS=5

# Exa.ai API Key (for neural web search)
# Sign up at https://exa.ai to get an API key
EXA_API_KEY=your_exa_api_key

# Apify API Token (for TikTok, Instagram, Twitter scraping)
# Sign up at https://apify.com to get an API token
# Apify provides professional-grade scraping with anti-bot handling and proxies
APIFY_API_TOKEN=your_apify_api_token

# Optional: Model configuration
GEMINI_MODEL=gemini-3.1-pro-preview
MAX_AGENT_STEPS=10
TOOL_EXECUTION_CONCURRENCY=4

# Optional: API timeout (in seconds)
API_TIMEOUT_SECONDS=30

# ===========================================
# Web API Server Configuration
# ===========================================

# API Server settings
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Authentication (comma-separated list of valid API keys)
# Leave empty to disable authentication (dev mode)
API_KEYS=
API_KEY_HEADER=X-API-Key

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=60

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=*

# SSE streaming keep-alive ping interval (seconds)
SSE_PING_INTERVAL=15

# OpenClaw deterministic UX progress gate (seconds)
OPENCLAW_PROGRESS_GATE_SECONDS=5

# ---------------------------------------------------------------- models
# Either provider drives the agents. OpenRouter is one key in front of many
# models; LLM_PROVIDER=auto (the default) prefers it when this is set.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.7-flash
# LLM_PROVIDER=auto

# ------------------------------------------------------------- demo mode
# Serve canned payloads from every streaming endpoint. No credentials needed,
# nothing downloaded, indexed or spent — for a deployed link anyone can click.
# DEMO_MODE=1

# --------------------------------------------------------------- download
# Some hosts refuse requests that do not identify themselves.
# DOWNLOAD_USER_AGENT=
